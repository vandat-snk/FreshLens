# ── FreshLens paths ─────────────────────────────────────────────
# Windows example. The code also accepts --root on every data command.
FRESHLENS_DATASET_ROOT=E:\\FreshLens\\dataset
FRESHLENS_MODEL_PATH=artifacts\\freshlens_model.joblib

# ── MongoDB ──────────────────────────────────────────────────────
# Lấy URI tại: https://www.mongodb.com/atlas (free 512MB)
# Local:  mongodb://localhost:27017/
# Atlas:  mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=freshlens

# ── Cloudinary (lưu ảnh, free 25GB) ─────────────────────────────
# Lấy tại: https://cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Kaggle API (tải dataset tự động) ────────────────────────────
# Lấy tại: https://www.kaggle.com/settings → API → Create New Token
# Hoặc đặt kaggle.json vào: C:\Users\<tên>\.kaggle\kaggle.json
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_key
